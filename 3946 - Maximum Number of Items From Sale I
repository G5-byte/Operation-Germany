class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int n = items.length;
        int[] freeCount = new int[n];
        int minPrice = Integer.MAX_VALUE;

        for (int i = 0; i < n; i++) {
            minPrice = Math.min(minPrice, items[i][1]);
            int fi = items[i][0];
            for (int j = 0; j < n; j++) {
                if (i != j && items[j][0] % fi == 0) {
                    freeCount[i]++;
                }
            }
        }

        final int NEG_INF = Integer.MIN_VALUE / 4;
        int[] dp = new int[budget + 1];
        java.util.Arrays.fill(dp, NEG_INF);
        dp[0] = 0;

        for (int i = 0; i < n; i++) {
            int price = items[i][1];
            int value = 1 + freeCount[i];
            if (price > budget) {
                continue;
            }
            for (int b = budget; b >= price; b--) {
                if (dp[b - price] != NEG_INF) {
                    dp[b] = Math.max(dp[b], dp[b - price] + value);
                }
            }
        }

        int ans = 0;
        for (int spent = 0; spent <= budget; spent++) {
            if (dp[spent] != NEG_INF) {
                int rem = budget - spent;
                int total = dp[spent] + (rem / minPrice);
                ans = Math.max(ans, total);
            }
        }

        return ans;
    }
}
