import java.util.Arrays;

class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        int INF = 1_000_000;
        
        // cost[i][j] = min changes to make s[i..j] a semi-palindrome
        int[][] cost = new int[n][n];
        for (int[] row : cost) {
            Arrays.fill(row, INF);
        }
        
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int len = j - i + 1;
                // Check all proper divisors d of len
                for (int d = 1; d < len; d++) {
                    if (len % d == 0) {
                        int changes = 0;
                        // Check each of the d groups
                        for (int rem = 0; rem < d; rem++) {
                            int left = i + rem;
                            int right = j - (d - 1 - rem);
                            while (left < right) {
                                if (s.charAt(left) != s.charAt(right)) {
                                    changes++;
                                }
                                left += d;
                                right -= d;
                            }
                        }
                        cost[i][j] = Math.min(cost[i][j], changes);
                    }
                }
            }
        }
        
        // dp[i][parts] = min changes to partition prefix of length i into 'parts' semi-palindromes
        int[][] dp = new int[n + 1][k + 1];
        for (int[] row : dp) {
            Arrays.fill(row, INF);
        }
        dp[0][0] = 0;
        
        for (int parts = 1; parts <= k; parts++) {
            // Each semi-palindrome has length at least 2
            for (int i = parts * 2; i <= n; i++) {
                for (int prev = (parts - 1) * 2; prev <= i - 2; prev++) {
                    if (dp[prev][parts - 1] != INF) {
                        dp[i][parts] = Math.min(dp[i][parts], dp[prev][parts - 1] + cost[prev][i - 1]);
                    }
                }
            }
        }
        
        return dp[n][k];
    }
}
