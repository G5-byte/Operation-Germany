import java.util.*;

class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int maxF = 0;
        for (int[] item : items) {
            if (item[0] > maxF) {
                maxF = item[0];
            }
        }

        int[] freq = new int[maxF + 1];
        for (int[] item : items) {
            freq[item[0]]++;
        }

        // divCount[f] = total number of items whose factor is a multiple of f
        int[] divCount = new int[maxF + 1];
        for (int f = 1; f <= maxF; f++) {
            if (freq[f] > 0) {
                for (int mult = f; mult <= maxF; mult += f) {
                    divCount[f] += freq[mult];
                }
            }
        }

        Arrays.sort(items, Comparator.comparingInt(a -> a[1]));
        long minPrice = items[0][1];
        long remBudget = budget;
        long totalItems = 0;

        for (int[] item : items) {
            int f = item[0];
            long price = item[1];

            if (price > 2 * minPrice || remBudget < price) {
                break;
            }

            long gain = divCount[f] - 1;
            if (gain > 0) {
                long take = Math.min(gain, remBudget / price);
                totalItems += 2 * take;
                remBudget -= take * price;
            }
        }

        totalItems += remBudget / minPrice;
        return (int) totalItems;
    }
}
