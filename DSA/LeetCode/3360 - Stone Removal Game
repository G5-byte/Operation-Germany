class Solution {
    public boolean canAliceWin(int n) {
        int move = 10;
        boolean aliceTurn = true;
        
        while (n >= move) {
            n -= move;
            move--;
            aliceTurn = !aliceTurn;
        }
        
        // If aliceTurn is true, Alice is the one who cannot make the current move and loses.
        return !aliceTurn;
    }
}
